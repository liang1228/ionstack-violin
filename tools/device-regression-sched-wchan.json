{
  "outputRoot": "E:\\workspace\\projects\\xiaomi-root\\outputs\\device-regression",
  "launchUrl": "http://127.0.0.1:18000/index.html?payload=sched-wchan",
  "packageName": "org.mozilla.firefox",
  "action": "android.intent.action.VIEW",
  "maxRounds": 1,
  "roundTimeoutSec": 45,
  "pollIntervalMs": 2000,
  "recoverTimeoutSec": 240,
  "bootCompletedTimeoutSec": 240,
  "appendRoundToken": true,
  "rebootBetweenRounds": false,
  "stopOnSuccess": true,
  "adbReverse": [
    {
      "device": "tcp:18000",
      "host": "tcp:18000"
    }
  ],
  "serverLogPath": "E:\\workspace\\projects\\xiaomi-root\\analysis_outputs\\bootimg\\local_http_server.err.log",
  "localTextArtifacts": [
    {
      "name": "firefox-result",
      "path": "E:\\workspace\\projects\\xiaomi-root\\outputs\\firefox-result-monitor\\latest-result.txt"
    },
    {
      "name": "firefox-result-done",
      "path": "E:\\workspace\\projects\\xiaomi-root\\outputs\\firefox-result-monitor\\latest-result.done.txt"
    },
    {
      "name": "firefox-status",
      "path": "E:\\workspace\\projects\\xiaomi-root\\outputs\\firefox-result-monitor\\latest-status.txt"
    },
    {
      "name": "latest-run-crash",
      "path": "E:\\workspace\\projects\\xiaomi-root\\analysis_outputs\\latest_run\\crash.txt"
    }
  ],
  "remotePullGlobs": [
    "/sdcard/Download/crash*.txt",
    "/sdcard/Download/ionstack-log-*.txt"
  ],
  "stages": [
    {
      "name": "page_request",
      "patterns": [
        "GET /\\?v="
      ],
      "requireAll": true
    },
    {
      "name": "iframe_request",
      "patterns": [
        "GET /exploit\\.html\\?run="
      ],
      "requireAll": true
    },
    {
      "name": "payload_fetch",
      "patterns": [
        "GET /preload-local-violin-stable0-faketask-khdrpi\\.so"
      ],
      "requireAll": true
    },
    {
      "name": "slide_route_done",
      "patterns": [
        "SLIDEW5: route done"
      ],
      "requireAll": true
    },
    {
      "name": "no_kernel_pointer",
      "patterns": [
        "SLIDER2_BAD:"
      ],
      "requireAll": true
    }
  ],
  "success": {
    "patterns": [
      "SLIDEW5: route done",
      "SLIDER2_BAD:"
    ],
    "requireAll": true
  },
  "failures": [
    {
      "name": "kernel_panic",
      "patterns": [
        "Kernel panic - not syncing",
        "Fatal exception"
      ],
      "requireAll": false
    }
  ]
}
